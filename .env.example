# Alle Werte sind optional. Ohne Konfiguration spricht die App den Origin an,
# von dem sie geladen wurde — lokal reicht der WebSocket-Proxy des
# Vite-Dev-Servers, im Deployment liefert derselbe Prozess PWA und Signaling.

# --- Client (Buildzeit) -----------------------------------------------------

# Nur nötig, wenn der Signaling-Server woanders läuft als die PWA:
# VITE_SIGNALING_URL=wss://walky-signaling.example.com

# --- Server (Laufzeit, auf Fly: `fly secrets set …`) ------------------------

# TURN-Relay. Ohne eines scheitert die Verbindung zwischen verschiedenen
# Netzen — im Mobilfunk praktisch immer. Der Server liefert die Angaben unter
# /api/ice aus, die Zugangsdaten landen also nie im öffentlichen Bundle.

# Variante A: Cloudflare Realtime, Zugangsdaten werden kurzlebig erzeugt.
# Beide Werte stammen aus Realtime -> TURN -> TURN-Schluessel anlegen.
# Nicht zu verwechseln mit R2: "Access Key ID" und "Secret Access Key"
# gehoeren zum Objektspeicher und funktionieren hier nicht.
# CLOUDFLARE_TURN_TOKEN_ID=...   # im Dashboard "TURN Token ID"
# CLOUDFLARE_TURN_API_TOKEN=...  # im Dashboard "API Token"

# Variante B: ein Anbieter mit festen Zugangsdaten.
# TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# TURN_USERNAME=walky
# TURN_CREDENTIAL=geheim

# Eigene STUN-Server (Komma-getrennt). Default: Google STUN.
# STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
