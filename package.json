{
  "name": "walky",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Walkie-Talkie PWA \u2014 Push-to-Talk \u00fcber WebRTC, Signaling \u00fcber eigenen WebSocket-Server",
  "scripts": {
    "dev": "vite",
    "dev:server": "npm run build:server && node --watch dist-server/server/index.js",
    "dev:host": "vite --host",
    "build": "npm run typecheck && vite build && npm run build:server",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist-server/server/index.js",
    "preview": "npm run build && npm start",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/generate-icons.mjs && node scripts/generate-silence.mjs",
    "watch:server": "tsc -p tsconfig.server.json --watch --preserveWatchOutput"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sirv": "^3.0.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "jsdom": "^28.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  }
}
